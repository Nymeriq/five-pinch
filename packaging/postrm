#!/bin/sh
set -e
case "$1" in
    remove|purge)
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger --action=change --subsystem-match=input --property-match=ID_INPUT_TOUCHPAD=1 || true
        fi
        echo 'Five Pinch removed. Log out and back in to unload any running extension.'
        ;;
esac
if [ "$1" = purge ]; then
    # Only the three files created by our optional repository setup script.
    rm -f /etc/apt/sources.list.d/five-pinch.sources \
          /etc/apt/preferences.d/five-pinch \
          /etc/apt/keyrings/five-pinch.gpg
fi
exit 0
