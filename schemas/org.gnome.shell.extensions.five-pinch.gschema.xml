<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.five-pinch" path="/org/gnome/shell/extensions/five-pinch/">
    <key name="protect-pinch-tail" type="b"><default>true</default><summary>Suppress new swipe sequences only in the tail of a five-contact cycle</summary></key>
    <key name="tail-status" type="s"><default>'Waiting for five-finger contact.'</default><summary>Latest pinch-tail protection decision, without coordinates</summary></key>
    <key name="sensitivity" type="s"><choices><choice value="original"/><choice value="balanced"/><choice value="relaxed"/></choices><default>'balanced'</default><summary>Recognition sensitivity; original restores the 0.5.1 thresholds</summary></key>
    <key name="device-path" type="s"><default>''</default><summary>Optional touchpad event device path; empty selects automatically</summary></key>
    <key name="enabled" type="b"><default>false</default><summary>Enable recognition</summary></key>
    <key name="pinch-in" type="s"><choices><choice value="disabled"/><choice value="diagnostic"/><choice value="apps"/><choice value="apps-close"/><choice value="overview"/><choice value="hide"/></choices><default>'disabled'</default><summary>Pinch inward action</summary></key>
    <key name="pinch-out" type="s"><choices><choice value="disabled"/><choice value="diagnostic"/><choice value="apps"/><choice value="apps-close"/><choice value="overview"/><choice value="hide"/></choices><default>'disabled'</default><summary>Pinch outward action</summary></key>
    <key name="status" type="s"><default>'Extension has not started yet.'</default><summary>Current reader status</summary></key>
    <key name="last-event" type="s"><default>'No gesture detected yet.'</default><summary>Last recognized gesture</summary></key>
  </schema>
</schemalist>
